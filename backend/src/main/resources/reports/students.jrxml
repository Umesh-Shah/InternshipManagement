<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="students" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <field name="studentId"        class="java.lang.Integer"/>
    <field name="fname"            class="java.lang.String"/>
    <field name="lname"            class="java.lang.String"/>
    <field name="year"             class="java.lang.Integer"/>
    <field name="country"          class="java.lang.String"/>
    <field name="semester"         class="java.lang.String"/>
    <field name="internshipStatus" class="java.lang.String"/>
    <field name="studentStatus"    class="java.lang.String"/>

    <title height="40">
        <element kind="staticText" x="0" y="5" width="802" height="30" hTextAlign="Center" fontSize="18.0" bold="true">
            <text><![CDATA[Student Report]]></text>
        </element>
    </title>

    <columnHeader height="22" splitType="Stretch">
        <element kind="rectangle" x="0" y="0" width="802" height="22" backcolor="#4472C4" forecolor="#4472C4">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="0"   y="2" width="50"  height="18" forecolor="#FFFFFF" bold="true" fontSize="9.0">
            <text><![CDATA[ID]]></text>
        </element>
        <element kind="staticText" x="50"  y="2" width="100" height="18" forecolor="#FFFFFF" bold="true" fontSize="9.0">
            <text><![CDATA[First Name]]></text>
        </element>
        <element kind="staticText" x="150" y="2" width="100" height="18" forecolor="#FFFFFF" bold="true" fontSize="9.0">
            <text><![CDATA[Last Name]]></text>
        </element>
        <element kind="staticText" x="250" y="2" width="52"  height="18" forecolor="#FFFFFF" bold="true" fontSize="9.0">
            <text><![CDATA[Year]]></text>
        </element>
        <element kind="staticText" x="302" y="2" width="100" height="18" forecolor="#FFFFFF" bold="true" fontSize="9.0">
            <text><![CDATA[Country]]></text>
        </element>
        <element kind="staticText" x="402" y="2" width="100" height="18" forecolor="#FFFFFF" bold="true" fontSize="9.0">
            <text><![CDATA[Semester]]></text>
        </element>
        <element kind="staticText" x="502" y="2" width="150" height="18" forecolor="#FFFFFF" bold="true" fontSize="9.0">
            <text><![CDATA[Internship Status]]></text>
        </element>
        <element kind="staticText" x="652" y="2" width="150" height="18" forecolor="#FFFFFF" bold="true" fontSize="9.0">
            <text><![CDATA[Student Status]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="18" splitType="Stretch">
            <element kind="textField" x="0"   y="1" width="50"  height="16" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA[$F{studentId}]]></expression>
            </element>
            <element kind="textField" x="50"  y="1" width="100" height="16" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA[$F{fname}]]></expression>
            </element>
            <element kind="textField" x="150" y="1" width="100" height="16" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA[$F{lname}]]></expression>
            </element>
            <element kind="textField" x="250" y="1" width="52"  height="16" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA[$F{year}]]></expression>
            </element>
            <element kind="textField" x="302" y="1" width="100" height="16" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA[$F{country}]]></expression>
            </element>
            <element kind="textField" x="402" y="1" width="100" height="16" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA[$F{semester}]]></expression>
            </element>
            <element kind="textField" x="502" y="1" width="150" height="16" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA[$F{internshipStatus}]]></expression>
            </element>
            <element kind="textField" x="652" y="1" width="150" height="16" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA[$F{studentStatus}]]></expression>
            </element>
        </band>
    </detail>

    <noData height="30">
        <element kind="staticText" x="0" y="5" width="802" height="20" hTextAlign="Center" fontSize="11.0">
            <text><![CDATA[No data found for the selected filters.]]></text>
        </element>
    </noData>

</jasperReport>
